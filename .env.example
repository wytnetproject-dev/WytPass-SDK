# ==============================================================================
# WytPass SDK - Environment Configuration Template
# COPY THIS FILE TO .env.local OR .env AND FILL IN YOUR CREDENTIALS.
# NEVER COMMIT REAL CLIENT SECRETS OR ACCESS TOKENS TO SOURCE CONTROL!
# ==============================================================================

# OAuth Client ID (Obtained from WytPass Developer Console)
WYTPASS_CLIENT_ID=your_client_id_here

# OAuth Client Secret (CONFIDENTIAL: Node.js / Next.js Server-side ONLY! Never expose in React/Browser)
WYTPASS_CLIENT_SECRET=your_client_secret_here

# Redirect URI configured in WytPass Application Settings
WYTPASS_REDIRECT_URI=http://localhost:3000/api/auth/wytpass/callback

# Default WytPass OIDC Issuer (Defaults to https://api.wytnet.com in production)
WYTPASS_ISSUER=https://api.wytnet.com

# Optional Scope Override (Default: openid profile email)
WYTPASS_SCOPE=openid profile email

# Optional Custom Endpoint Overrides (for local mock servers or staging environments)
# WYTPASS_AUTHORIZATION_ENDPOINT=https://wytnet.com/oauth/authorize
# WYTPASS_TOKEN_ENDPOINT=https://api.wytnet.com/oauth/token
# WYTPASS_USERINFO_ENDPOINT=https://api.wytnet.com/oauth/userinfo
# WYTPASS_JWKS_ENDPOINT=https://api.wytnet.com/.well-known/jwks.json
