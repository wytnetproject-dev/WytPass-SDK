# ==============================================================================
# WytPass SDK - Environment Configuration Template
# COPY THIS FILE TO .env.local OR .env AND FILL IN YOUR CREDENTIALS.
# ==============================================================================

# ------------------------------------------------------------------------------
# CLIENT APPLICATIONS (React, Vite, Next.js Browser):
# Zero configuration! The only project-specific value required is your Client ID.
# All endpoints, OIDC configs, PKCE, scopes, and redirect URIs are managed internally.
# ------------------------------------------------------------------------------
VITE_WYTPASS_CLIENT_ID=wp_xxxxxxxxx
# or for Next.js:
# NEXT_PUBLIC_WYTPASS_CLIENT_ID=wp_xxxxxxxxx

# ------------------------------------------------------------------------------
# CONFIDENTIAL SERVER ENVIRONMENTS (Node.js / Next.js Route Handlers):
# ------------------------------------------------------------------------------
WYTPASS_CLIENT_ID=wp_xxxxxxxxx
WYTPASS_CLIENT_SECRET=your_client_secret_here

# Optional: Custom Redirect URI override (automatically resolved if omitted)
# WYTPASS_REDIRECT_URI=http://localhost:3000/api/auth/wytpass/callback
