{
  "name": "@wytpass/nextjs",
  "version": "0.1.1",
  "description": "Next.js App Router and Pages Router SDK for WytPass SSO, OAuth 2.0 and OpenID Connect authentication",
  "author": "Wytnet <support@wytnet.com>",
  "license": "MIT",
  "homepage": "https://wytnet.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/wytnet/wytpass-sdk.git",
    "directory": "packages/nextjs"
  },
  "bugs": {
    "url": "https://github.com/wytnet/wytpass-sdk/issues"
  },
  "keywords": [
    "wytpass",
    "oauth2",
    "oidc",
    "nextjs",
    "next-auth",
    "app-router",
    "sso",
    "authentication",
    "pkce"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@wytpass/core": "^0.1.1"
  },
  "peerDependencies": {
    "next": ">=13.0.0 || >=14.0.0 || >=15.0.0",
    "react": ">=18.0.0 || >=19.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "react": "^18.3.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
